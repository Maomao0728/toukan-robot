{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "投刊机器人",
  "version": "0.1.0",
  "identifier": "com.toukan.robot",
  "build": {
    "beforeDevCommand": "cd ../frontend && node_modules\\.bin\\vite.cmd --host 127.0.0.1 --port 1420",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "cd ../frontend && node_modules\\.bin\\tsc.cmd && node_modules\\.bin\\vite.cmd build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "投刊机器人",
        "width": 1360,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "投刊机器人",
    "resources": {
      "../../data/db/seed_data/toukan_robot.sqlite3": "seed_data/toukan_robot.sqlite3",
      "../../data/templates": "seed_templates"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "perMachine"
      }
    },
    "icon": [
      "icons/icon.ico"
    ]
  }
}
